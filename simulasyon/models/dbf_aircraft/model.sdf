<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="dbf_aircraft">
    <pose>0 0 0.3 0 0 0</pose>
    <static>false</static>

    <!-- Main Fuselage and Wing Structure -->
    <link name="base_link">
      <inertial>
        <mass>13.65</mass>
        <pose>0.15 0 0.05 0 0 0</pose>
        <inertia>
          <ixx>1.85</ixx>
          <ixy>0.0</ixy>
          <ixz>0.05</ixz>
          <iyy>1.42</iyy>
          <iyz>0.0</iyz>
          <izz>3.10</izz>
        </inertia>
      </inertial>

      <!-- Fuselage Collision & Visual -->
      <collision name="fuselage_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.65 0.22 0.24</size>
          </box>
        </geometry>
      </collision>
      <visual name="fuselage_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.65 0.22 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1.0</ambient>
          <diffuse>0.2 0.2 0.9 1.0</diffuse>
        </material>
      </visual>

      <!-- Main High-Lift Wing (Span: 2.40m, Chord: 0.30m) -->
      <collision name="wing_collision">
        <pose>0.12 0 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 2.40 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="wing_visual">
        <pose>0.12 0 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 2.40 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- Horizontal Stabilizer -->
      <visual name="hstab_visual">
        <pose>-0.70 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.70 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
        </material>
      </visual>

      <!-- Vertical Fin -->
      <visual name="vfin_visual">
        <pose>-0.68 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.02 0.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
        </material>
      </visual>
    </link>

    <!-- Mission 3 Internal Payload Link (11.2 kg) -->
    <link name="payload_link">
      <pose>0.16 0 -0.02 0 0 0</pose>
      <inertial>
        <mass>11.20</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.12</iyy>
          <izz>0.12</izz>
        </inertia>
      </inertial>
      <collision name="payload_col">
        <geometry>
          <box>
            <size>0.35 0.15 0.12</size>
          </box>
        </geometry>
      </collision>
      <visual name="payload_vis">
        <geometry>
          <box>
            <size>0.35 0.15 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.8 0.0 1.0</ambient>
        </material>
      </visual>
    </link>

    <!-- Actuated Payload Release Joint -->
    <joint name="payload_release_joint" type="fixed">
      <parent>base_link</parent>
      <child>payload_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- Downward Looking Target Detection Camera -->
    <link name="camera_link">
      <pose>0.35 0 -0.10 0 1.5708 0</pose>
      <sensor name="downward_cam" type="camera">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>
